#!/usr/bin/env bash
# cc-run — quota-aware orchestrator for Claude Code.
#
# Two-tier quota protection:
#   - SOFT threshold (--threshold, default 80): the current todo item is
#     allowed to finish, then Claude wraps up cleanly (commit + progress.md).
#   - HARD threshold (--session-hard default 95, --weekly-hard default 98):
#     can fire mid-item. By default this only forces a clean stop (nothing
#     is touched automatically). Pass --enable-hard-abort to also revert the
#     in-progress item with `git stash` and redo it from scratch after reset
#     — see README before turning this on, it rewrites your working tree.
#
# Flags are only exported as CC_* env vars when you actually pass them. If
# you don't pass a flag, quota_gate.py falls back to (in order): your
# project's .cc-quota/config.json, the values you picked in the plugin's
# install/configure screen, then the built-in defaults above. Passing a flag
# here always wins over all of those, for this run only.
#
# Flow:
#   1) Starts Claude with the task (thresholds passed as env vars, if given).
#   2) The quota_gate hook (installed on TodoWrite + every tool) stops Claude
#      when a threshold is hit (soft: clean stop; hard: clean stop, or
#      revert+stop if hard-abort is enabled) and leaves .cc-quota/STOP.json.
#   3) This script reads the reset time from STOP.json, SLEEPS until then,
#      removes the marker, and resumes with `claude -c`.
#   4) When Claude finishes the whole task it writes "CC_QUOTA_DONE" into
#      .cc-quota/progress.md; this script sees that and stops.
#
# Usage:
#   cc-run --threshold 80 --session-hard 95 --weekly-hard 98 "the task..."
#   cc-run --enable-hard-abort @task.md
#   cc-run "the task..."   # use whatever plugin/project config says (or built-in defaults)
#
# Requires: bash, python3, claude (CLI). The hard-abort revert also requires git.
set -euo pipefail

THRESHOLD=""
SESSION_HARD=""
WEEKLY_HARD=""
HARD_ABORT=""
MODEL=""
BUFFER_SECONDS="${CC_RESUME_BUFFER:-60}"
# So Claude can keep editing headlessly across resumes without asking for
# approval each time. WARNING: acceptEdits lets Claude make file edits
# WITHOUT asking. If that's not acceptable, set CC_CLAUDE_ARGS="" and run
# interactively instead.
CLAUDE_ARGS="${CC_CLAUDE_ARGS:---permission-mode acceptEdits}"
PROJ="$(pwd)"

usage() {
  cat <<EOF
cc-run — quota-aware Claude Code runner

  --threshold N        Session SOFT threshold (default 80 if not set anywhere else). Finishes the current item, then stops.
  --session-hard N     Session HARD threshold (default 95 if not set anywhere else). Can fire mid-item.
  --weekly-hard N      Weekly HARD threshold (default 98 if not set anywhere else). Can fire mid-item.
  --enable-hard-abort   Force auto-revert (git stash) ON for this run when a HARD threshold fires.
                         If you don't pass this, hard-abort follows your plugin/project
                         configuration (built-in default: off).
  --model NAME          Model to use (alias like 'opus'/'sonnet'/'fable', or a full model
                         name). If you don't pass this, whatever your 'claude' CLI's own
                         default is applies (same as running 'claude' with no --model).
  --help                this help

None of these flags are required — without them, thresholds come from your
project's .cc-quota/config.json, then the plugin's configure screen, then
the built-in defaults (80 / 95 / 98 / hard-abort off).

Task: the last argument. Plain text, or @file.md (the file's content becomes the task).
EOF
}

TASK=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --threshold)        THRESHOLD="$2"; shift 2;;
    --session-hard)     SESSION_HARD="$2"; shift 2;;
    --weekly-hard)      WEEKLY_HARD="$2"; shift 2;;
    --enable-hard-abort) HARD_ABORT="1"; shift;;
    --model)             MODEL="$2"; shift 2;;
    --help|-h)           usage; exit 0;;
    *)                   TASK="$1"; shift;;
  esac
done

if [[ -z "$TASK" ]]; then
  echo "Error: no task given." >&2; usage; exit 1
fi
if [[ "$TASK" == @* ]]; then
  f="${TASK:1}"
  [[ -f "$f" ]] || { echo "Error: task file not found: $f" >&2; exit 1; }
  TASK="$(cat "$f")"
fi

command -v claude >/dev/null   || { echo "Error: 'claude' CLI not found." >&2; exit 1; }
command -v python3 >/dev/null  || { echo "Error: python3 is required." >&2; exit 1; }

# Only export what was actually passed on the command line — an unset var
# here lets quota_gate.py fall through to project config / plugin config /
# built-in defaults instead of being silently overridden by this script.
[[ -n "$THRESHOLD" ]]    && export CC_SESSION_SOFT="$THRESHOLD"
[[ -n "$SESSION_HARD" ]] && export CC_SESSION_HARD="$SESSION_HARD"
[[ -n "$WEEKLY_HARD" ]]  && export CC_WEEKLY_HARD="$WEEKLY_HARD"
[[ "$HARD_ABORT" == "1" ]] && export CC_HARD_ABORT="1"
[[ -n "$MODEL" ]] && CLAUDE_ARGS="$CLAUDE_ARGS --model $MODEL"

if git -C "$PROJ" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  IS_GIT=1
else
  IS_GIT=0
fi

if [[ "$HARD_ABORT" == "1" ]]; then
  if [[ "$IS_GIT" == "1" ]]; then
    echo "→ [cc-run] --enable-hard-abort passed: hard-abort is ON for this run (git stash on a HARD threshold)."
  else
    echo "⚠️  [cc-run] --enable-hard-abort passed but this isn't a git repo: hard-abort will fall back to a clean stop." >&2
  fi
else
  echo "→ [cc-run] hard-abort not forced here — using your plugin/project configuration (built-in default: off)."
fi

# Windows/Git-Bash note: bash sees paths like /c/proje/hns, but python3 here
# is typically a native Win32 build that can't open that form at all. When
# cygpath is available (Git Bash ships it), convert to a form python3 can
# open; elsewhere (macOS/Linux) bash and python3 already agree on paths, so
# this is a no-op passthrough. Every python3 call below that touches a file
# path uses the _PY variant; bash's own file tests keep using the original.
to_py_path() {
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "$1"
  else
    printf '%s' "$1"
  fi
}
PROJ_PY="$(to_py_path "$PROJ")"

MARKER="$PROJ/.cc-quota/STOP.json"
MARKER_PY="$PROJ_PY/.cc-quota/STOP.json"
PROGRESS="$PROJ/.cc-quota/progress.md"
mkdir -p "$PROJ/.cc-quota"

# If a PREVIOUS, unrelated run already finished in this project, its
# progress.md still has "CC_QUOTA_DONE" in it. Without this, a brand-new
# task started here would see that leftover marker after its very first
# round and immediately report success — before Claude has done anything
# for THIS task. Archive it so this run starts from a clean completion
# state; the old file isn't lost, just renamed out of the way.
if [[ -f "$PROGRESS" ]] && grep -q '^CC_QUOTA_DONE' "$PROGRESS"; then
  mv "$PROGRESS" "${PROGRESS}.done-$(date +%Y%m%d%H%M%S)"
  echo "ℹ️  [cc-run] Previous run's finished progress.md archived (this project already had a completed run here)."
fi

RULES=$(cat <<EOF

--- QUOTA RULES (cc-run) ---
A two-tier "quota gate" is active:
- SOFT threshold: you may finish the current todo item; before moving to
  the next one you'll get an instruction to wrap up cleanly (update
  progress.md, commit, stop).
- HARD threshold: can fire mid-item. $( if [[ "$HARD_ABORT" == "1" ]]; then echo "auto-revert is ON for this run — changes on the current item will be reverted with 'git stash' without your involvement and the item goes back to 'pending'. When you see this, do NOT commit (the revert already happened), just leave a short note and stop."; else echo "auto-revert wasn't forced on for this run; whether it fires depends on your plugin/project configuration (default: off, meaning you'll just be told to stop as safely as possible). If a message tells you changes were reverted, do NOT commit — just leave a short note and stop."; fi )
.cc-quota/progress.md is kept up to date in both cases; work resumes from
there after the reset. If an item was reverted due to quota, progress.md
says so explicitly — redo that item from scratch.
When the ENTIRE task is done, append a line containing only "CC_QUOTA_DONE"
to the end of .cc-quota/progress.md (this is the completion signal).

--- VISIBILITY (cc-run) ---
This runs headless — nothing you print reaches a screen except plain text
output. So the person running this has SOME visibility instead of silence
until the very end: right before you start each todo item, print one short
line "-> <item>"; right after you finish one, print one short line
"[done] <item>". Keep these to a few words each. This is in addition to,
not instead of, your normal final summary.
EOF
)

# Current in_progress todo item's text, for heartbeat lines (best-effort).
# Takes the project path as argv (not embedded in the script string) so it
# works regardless of what characters are in it.
current_item() {
  python3 -c "
import json, os, sys
try:
    with open(os.path.join(sys.argv[1], '.cc-quota', 'todos_state.json')) as f:
        d = json.load(f)
    ip = d.get('in_progress')
    print(ip['content'] if ip else '')
except Exception:
    print('')
" "$PROJ_PY" 2>/dev/null
}

# Path to the stream renderer, resolved relative to this script (works
# whether this is the plugin's cached copy or an install.sh copy — both
# keep bin/ and scripts/ as siblings). Empty if it's missing for some
# reason, in which case we fall back to plain text output.
CC_RUN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STREAM_RENDERER="$CC_RUN_DIR/../scripts/stream_render.py"
[[ -f "$STREAM_RENDERER" ]] || STREAM_RENDERER=""

# Runs `claude <args>` in the background and prints a heartbeat line every
# 15s while it's running, so a long silent stretch doesn't look like it
# hung. When the stream renderer is available, output goes through
# --output-format stream-json so we can also show which model actually ran
# (aliases like "opus" resolve to a specific dated model) and which tool is
# running — same underlying request, just parsed instead of printed raw.
run_claude_with_heartbeat() {
  if [[ -n "$STREAM_RENDERER" ]]; then
    claude $CLAUDE_ARGS --output-format stream-json --verbose "$@" \
      | python3 "$(to_py_path "$STREAM_RENDERER")" &
  else
    claude $CLAUDE_ARGS "$@" &
  fi
  local pid=$!
  local waited=0
  while kill -0 "$pid" 2>/dev/null; do
    sleep 15
    waited=$((waited + 15))
    local item
    item="$(current_item)"
    if [[ -n "$item" ]]; then
      echo "⏳ [cc-run] still working (${waited}s) — current item: $item"
    else
      echo "⏳ [cc-run] still working (${waited}s)"
    fi
  done
  wait "$pid" || true
}

# resets_at (ISO 8601) -> seconds to sleep from now. Falls back if missing.
sleep_seconds_until() {
  local iso="$1" fallback="$2"
  python3 - "$iso" "$fallback" <<'PY'
import sys, time
from datetime import datetime, timezone
iso, fallback = sys.argv[1], int(sys.argv[2])
if not iso or iso == "null":
    print(fallback); raise SystemExit
try:
    s = iso.replace("Z", "+00:00")
    dt = datetime.fromisoformat(s)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    secs = int(dt.timestamp() - time.time())
    print(max(secs, 0))
except Exception:
    print(fallback)
PY
}

is_done() { [[ -f "$PROGRESS" ]] && grep -q '^CC_QUOTA_DONE' "$PROGRESS"; }

ITER=0
while true; do
  ITER=$((ITER+1))
  rm -f "$MARKER"

  if [[ $ITER -eq 1 ]]; then
    echo "▶️  [cc-run] Starting (soft=${THRESHOLD:-default}%, hard-session=${SESSION_HARD:-default}%, hard-weekly=${WEEKLY_HARD:-default}%, model=${MODEL:-claude default})"
    PROMPT="$TASK"$'\n'"$RULES"
    run_claude_with_heartbeat -p "$PROMPT"
  else
    echo "▶️  [cc-run] Resuming where it left off (round $ITER)"
    RESUME_PROMPT="Read .cc-quota/progress.md. If an item was reverted due to quota (back to pending), redo it FROM SCRATCH; then continue the remaining tasks from where you left off.${RULES}"
    run_claude_with_heartbeat -c -p "$RESUME_PROMPT"
  fi

  if is_done; then
    echo "✅ [cc-run] Task complete (CC_QUOTA_DONE)."
    break
  fi

  if [[ -f "$MARKER" ]]; then
    MODE=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("mode","soft"))' "$MARKER_PY" 2>/dev/null || echo "soft")
    WINDOW=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("window",""))' "$MARKER_PY" 2>/dev/null || echo "")
    RESETS=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("resets_at") or "")' "$MARKER_PY" 2>/dev/null || echo "")
    ABORTED=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("aborted_item") or "")' "$MARKER_PY" 2>/dev/null || echo "")
    # 5-hour fallback for session, 1-hour fallback for weekly if resets_at is missing.
    FALLBACK=$([[ "$WINDOW" == "session" ]] && echo 18000 || echo 3600)
    SECS=$(sleep_seconds_until "$RESETS" "$FALLBACK")
    SECS=$((SECS + BUFFER_SECONDS))
    WAKE=$(python3 -c 'import sys,datetime;print((datetime.datetime.now()+datetime.timedelta(seconds=int(sys.argv[1]))).strftime("%Y-%m-%d %H:%M:%S"))' "$SECS")
    if [[ "$MODE" == "hard" && -n "$ABORTED" ]]; then
      echo "⏸️  [cc-run] HARD quota threshold ($WINDOW). '${ABORTED}' was reverted. Reset: ${RESETS:-unknown}. Sleeping ${SECS}s → resuming ~$WAKE."
    else
      echo "⏸️  [cc-run] Quota threshold ($WINDOW, mode=$MODE). Reset: ${RESETS:-unknown}. Sleeping ${SECS}s → resuming ~$WAKE."
    fi
    sleep "$SECS"
    continue
  fi

  # No marker, no done signal: Claude finished the round on its own or errored out. Stop the loop.
  echo "ℹ️  [cc-run] No STOP marker and no DONE signal — Claude ended the turn on its own. Stopping."
  echo "    (If you expected it to continue, check .cc-quota/progress.md and the terminal output.)"
  break
done
